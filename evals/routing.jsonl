// --- one-off / deployed seam -------------------------------------------------------
// tam-building, account-scoring, crm-enrichment, crm-deduplication,
// call-capture, agentic-engagement, standup, weekly-planning, ask-cargo,
// new-hire-detection, web-capture and win-loss-review are worked CDK examples
// that deploy a pipeline.
// build-tam-list, score-leads and research-account are one-offs: the same
// job once, in a turn. The
// same words describe both, so these cases pin which way each phrasing goes;
// a pipeline skill that starts winning the one-off prompts has stolen them.
{"prompt": "Our TAM is a stale CSV, I want it to live in Cargo as a model", "expect": "tam-building", "why": "The tell is where it lands: a model in the workspace, not a file or a chat answer."}
{"prompt": "Source every company that matches our ICP and keep them as a model in Cargo", "expect": "tam-building", "why": "Source and land as a model: the whole job of this pipeline in one sentence."}
{"prompt": "Build our account universe as a model the rest of our pipelines can read", "expect": "tam-building"}
{"prompt": "Stand up a pipeline that builds our market from the ICP in our context", "expect": "tam-building"}
{"prompt": "Build a TAM list of seed-stage SaaS companies in Europe", "expect": "build-tam-list", "why": "Same words as tam-building, opposite intent: a list handed back today, not a model in the workspace."}
{"prompt": "How many companies match our ICP in DACH?", "expect": "build-tam-list", "why": "A count is a one-off."}
{"prompt": "Keep our accounts scored as they arrive and re-score when the ICP changes", "expect": "account-scoring"}
{"prompt": "Our lead scoring is a spreadsheet nobody trusts", "expect": "account-scoring"}
{"prompt": "The accounts are already in our CRM, we just need them tiered against the ICP", "expect": "account-scoring", "why": "A book that already exists is account-scoring; tam-building is for the book that does not exist yet."}
{"prompt": "Why is this account tier A?", "expect": "account-scoring", "why": "Only the deployed scorer writes a rationale anyone can read back."}
{"prompt": "Score this list of 200 companies against our ICP and rank them", "expect": "score-leads", "why": "A supplied list, scored once: the one-off, not the deployed scorer."}
{"prompt": "Keep our CRM accounts filled", "expect": "crm-enrichment"}
{"prompt": "Keep our CRM companies filled", "expect": "crm-enrichment"}
{"prompt": "Nobody refreshes the company records", "expect": "crm-enrichment"}
{"prompt": "Refresh stale firmographics", "expect": "crm-enrichment"}
{"prompt": "Half our CRM company records are missing headcount and domain, and nobody refreshes them", "expect": "crm-enrichment"}
{"prompt": "Enrich this supplied spreadsheet of 50 company domains once", "expect": "enrich-company-data", "why": "A one-off list should not route to the CRM enrichment pipeline."}
{"prompt": "Enrich my CRM", "expect": "crm-enrichment"}
{"prompt": "Our account data was accurate a year ago, but new companies and old firmographics keep going stale", "expect": "crm-enrichment"}
{"prompt": "Every new CRM company should get standard identity and firmographics, then be refreshed when it goes stale", "expect": "crm-enrichment"}
{"prompt": "Keep our CRM contacts filled", "expect": "crm-enrichment"}
{"prompt": "Nobody refreshes the contact records", "expect": "crm-enrichment"}
{"prompt": "Every new CRM contact should get a LinkedIn profile, person ID, and title, then be refreshed when stale", "expect": "crm-enrichment"}
{"prompt": "Half our contacts are missing LinkedIn URLs and job titles, and nobody keeps them fresh", "expect": "crm-enrichment"}
{"prompt": "Enrich this supplied list of 40 LinkedIn profile URLs once", "expect": "enrich-linkedin-profile", "why": "A supplied one-off list should not route to the CRM contact pipeline."}
{"prompt": "Find work emails for these 50 people I exported", "expect": "find-work-email", "why": "A one-off email lookup stays with the email finder, not the contact pipeline's optional email route."}
{"prompt": "Deduplicate our CRM accounts and keep the ambiguous company matches in review", "expect": "crm-deduplication"}
{"prompt": "Set up recurring account deduplication in Cargo", "expect": "crm-deduplication"}
{"prompt": "Merge duplicate companies in HubSpot automatically when confidence is high, and ask me to review uncertain matches", "expect": "crm-deduplication"}
{"prompt": "Our CRM has duplicate account records sharing LinkedIn company IDs and domains", "expect": "crm-deduplication"}
{"prompt": "Clean duplicate contact records in HubSpot and keep low-confidence people matches in review", "expect": "crm-deduplication"}
{"prompt": "Set up recurring contact deduplication in Cargo", "expect": "crm-deduplication"}
{"prompt": "Our CRM has duplicate people with the same LinkedIn profile and phone number", "expect": "crm-deduplication"}
{"prompt": "Merge duplicate CRM contacts when the LinkedIn person ID matches exactly", "expect": "crm-deduplication"}
{"prompt": "Verify these emails", "expect": "verify-email-list", "why": "Email validation is the one-off verifier, not CRM contact deduplication."}
{"prompt": "Our call recordings never make it into the knowledge base", "expect": "call-capture"}
{"prompt": "Turn yesterday's call transcripts into context updates every morning", "expect": "call-capture", "why": "The standing tell: every morning, not this one call."}
{"prompt": "We relearn the same objection every quarter because nobody writes it down", "expect": "call-capture", "why": "The repetition bar promoting a twice-heard objection is exactly this pipeline."}
{"prompt": "Replace the GitHub Action that scribes our meetings into the repo", "expect": "call-capture"}
{"prompt": "We record our calls on Granola, not Avoma — scribe them into the repo every morning", "expect": "call-capture", "why": "Naming a recorder must not route away from the pipeline: nine ship and the recorder is a selection, not a fork."}
{"prompt": "Prep me for my call with this account tomorrow", "expect": "research-account", "why": "A call in the future is briefing work; call-capture only ever looks at calls already held."}
{"prompt": "Handle email conversations with leads", "expect": "agentic-engagement"}
{"prompt": "Stand up a conversation agent on a Cargo mailbox", "expect": "agentic-engagement"}
{"prompt": "An agent that replies to inbound email", "expect": "agentic-engagement"}
{"prompt": "Keep talking to leads over email", "expect": "agentic-engagement", "why": "The standing tell: a loop, not one send."}
{"prompt": "Native email trigger for lead replies", "expect": "agentic-engagement"}
{"prompt": "I need email addresses for these prospects so I can start conversations", "expect": "find-work-email", "why": "Addresses first; agentic-engagement is the loop you deploy after you have someone to write to."}
