{
  "name": "cargo",
  "displayName": "Cargo GTM",
  "description": "Twelve one-job GTM skills in Claude Code — find leads and stakeholders, build a TAM, resolve LinkedIn URLs, enrich companies and profiles, find and verify work emails, track job changes, funding, and tech intent — plus prompt-free approval for safe cargo-ai calls.",
  "version": "1.0.0",
  "author": { "name": "getcargo" },
  "homepage": "https://github.com/getcargohq/gtm-skills",
  "skills": ["./"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-cli.sh claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-checkpoint.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
