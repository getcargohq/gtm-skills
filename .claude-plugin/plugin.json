{
  "name": "cargo",
  "displayName": "Cargo GTM",
  "description": "Twenty-three routed GTM skills in Claude Code: one-off Cargo CLI jobs plus CDK cookbooks including account enrichment, with prompt-free approval for safe cargo-ai calls.",
  "version": "1.4.0",
  "author": {
    "name": "getcargo"
  },
  "homepage": "https://github.com/getcargohq/gtm-skills",
  "skills": [
    "./",
    "./cookbooks/account-enrichment"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-cli.sh claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-checkpoint.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
