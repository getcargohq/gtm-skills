{
  "name": "cargo",
  "displayName": "Cargo GTM",
  "description": "Twenty-one one-job GTM skills in Claude Code \u2014 find leads and stakeholders, build a TAM, resolve LinkedIn URLs, enrich companies, profiles and CRM records, find and verify work emails, track job changes, funding, hiring and tech intent, and migrate off Clay, Apollo or ZoomInfo \u2014 plus prompt-free approval for safe cargo-ai calls.",
  "version": "1.3.0",
  "author": {
    "name": "getcargo"
  },
  "homepage": "https://github.com/getcargohq/gtm-skills",
  "skills": [
    "./"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-cli.sh claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-checkpoint.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
