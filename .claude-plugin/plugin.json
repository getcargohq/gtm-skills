{
  "name": "cargo",
  "displayName": "Cargo GTM",
  "description": "Routed GTM skills in Claude Code, each focused on one job: one-off Cargo CLI workflows plus worked CDK examples an agent adapts and deploys, with prompt-free approval for safe cargo-ai calls.",
  "version": "1.4.0",
  "author": {
    "name": "getcargo"
  },
  "homepage": "https://github.com/getcargohq/gtm-skills",
  "skills": ["./"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-cli.sh claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-checkpoint.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
