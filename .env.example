# Copy to `.env` and fill in before `cargo-ai cdk deploy`. These are read at
# deploy time via `secret()` and kept out of the content hash (rotating them is
# not drift). Only the connectors a cookbook actually uses need to be set.
#
# base-gtm needs NOTHING here: its accounts and contacts models are native
# (workspace-owned), so it deploys on a fresh workspace with zero configuration.
# A key is needed only once you install a cookbook that talks to an outside
# system.

# crm-sync, and every cookbook that reads from or writes back to a CRM
# (inbound-flow, contact-sourcing, routing-engine, account-scoring,
# auto-enrichment, plg-motion, ai-sdr): a HubSpot private-app token.
# Swap the integration in crm-sync/connectors/hubspot.ts for salesforce or attio.
HUBSPOT_API_KEY=

# ai-sdr: Email Bison instance API key (outreach send).
EMAIL_BISON_API_KEY=

# plg-motion: Snowflake password for the product-analytics service user.
SNOWFLAKE_PASSWORD=

# Slack, OpenAI, Cargo DB, waterfall, and Sillage are OAuth- or credit-based and
# need no key here (they are adopted or authenticated in the workspace).
